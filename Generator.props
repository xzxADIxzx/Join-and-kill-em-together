<Project>

  <PropertyGroup>
    <List>
      AssistController@ac; CameraController@cc; CheatsController@ch; CheatsManager@cm; ColorBlindSettings@cb; FistControl@fc; GunControl@gc; GunSetter@gs; HookArm@ha; HudMessageReceiver@hm; NewMovement@nm; PostProcessV2_Handler@pp; PrefsManager@pm; SceneHelper@eh; StatsManager@sm; StyleHUD@sh;
    </List>
  </PropertyGroup>

  <ItemGroup>
    <Singletons Include="$(List)">
      <Type>$([System.String]::Copy('%(Identity)').Split('@')[0])</Type>
      <Name>$([System.String]::Copy('%(Identity)').Split('@')[1])</Name>
    </Singletons>
  </ItemGroup>

  <Target Name="Generate" BeforeTargets="BeforeCompile">

    <PropertyGroup>
      <Debug Condition="$(Configuration) == Debug">true</Debug>
      <Debug Condition="$(Configuration) != Debug">false</Debug>

      <GeneratedTools>

namespace Jaket.Tools %3B

public static partial class Tools
{
@(Singletons -> '    public static %(Type) %(Name) => %(Type).Instance %3B', '%0A')
}

      </GeneratedTools>
      <GeneratedVersion>

namespace Jaket %3B

public static partial class Version
{
    public const string CURRENT = "$(Version)" %3B
    public const bool DEBUG = $(Debug) %3B
}

      </GeneratedVersion>
      <GeneratedManifest>

{
    "name": "$(AssemblyName)",
    "description": "$(Description)",
    "version_number": "$(Version)",
    "website_url": "https://github.com/xzxADIxzx/Join-and-kill-em-together",
    "dependencies": [ "BepInEx-BepInExPack-5.4.2305" ]
}

      </GeneratedManifest>
    </PropertyGroup>

    <WriteLinesToFile File="$(IntermediateOutputPath)/Tools.g.cs" Lines="$(GeneratedTools)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(IntermediateOutputPath)/Version.g.cs" Lines="$(GeneratedVersion)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(IntermediateOutputPath)/manifest.json" Lines="$(GeneratedManifest)" Overwrite="true" WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)/Tools.g.cs" />
      <Compile Include="$(IntermediateOutputPath)/Version.g.cs" />
    </ItemGroup>

  </Target>

</Project>
