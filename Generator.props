<Project>

  <PropertyGroup>
    <Singletons>
      AssistController@ac; CameraController@cc; CheatsController@ch; CheatsManager@cm; ColorBlindSettings@cb; CrowdReactions@cr; EndlessGrid@eg; FistControl@fc; GunControl@gc; GunSetter@gs; HookArm@ha; HudController@hc; HudMessageReceiver@hm; NewMovement@nm; PostProcessV2_Handler@pp; PrefsManager@pm; SceneHelper@eh; StatsManager@sm; StyleHUD@sh; WeaponCharges@wc; WeaponWheel@ww;
    </Singletons>
  </PropertyGroup>

  <ItemGroup>
    <Properties Include="$(Singletons)">
      <Type>$([System.String]::Copy('%(Identity)').Split('@')[0])</Type>
      <Name>$([System.String]::Copy('%(Identity)').Split('@')[1])</Name>
    </Properties>
  </ItemGroup>

  <Target Name="Generate" BeforeTargets="BeforeCompile">

    <PropertyGroup>
      <GeneratedTools>

namespace Jaket.Tools %3B

public static partial class Tools
{
@(Properties -> '    public static %(Type) %(Name) => %(Type).Instance %3B', '%0A')

    public static UnityEngine.Transform nmtr => NewMovement     .Instance.transform %3B
    public static UnityEngine.Transform cctr => CameraController.Instance.transform %3B
    public static PlayerInput           imis => InputManager    .Instance.InputSource %3B
}

      </GeneratedTools>
      <GeneratedVersion>

namespace Jaket %3B

public static partial class Version
{
    public const string CURRENT = "$(Version)" %3B
    public const bool DEBUG = $(Configuration.Equals('Debug').ToString().ToLower()) %3B
}

      </GeneratedVersion>
      <GeneratedManifest>

{
    "name": "$(AssemblyName)",
    "description": "$(Description)",
    "version_number": "$(Version)",
    "website_url": "https://github.com/xzxADIxzx/Join-and-kill-em-together",
    "dependencies": [ "BepInEx-BepInExPack-5.4.2305" ]
}

      </GeneratedManifest>
    </PropertyGroup>

    <WriteLinesToFile File="$(IntermediateOutputPath)/Tools.g.cs" Lines="$(GeneratedTools)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(IntermediateOutputPath)/Version.g.cs" Lines="$(GeneratedVersion)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(IntermediateOutputPath)/manifest.json" Lines="$(GeneratedManifest)" Overwrite="true" WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)/Tools.g.cs" />
      <Compile Include="$(IntermediateOutputPath)/Version.g.cs" />
    </ItemGroup>

  </Target>

</Project>
